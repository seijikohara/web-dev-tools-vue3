{
  $schema: 'https://docs.renovatebot.com/renovate-schema.json',
  // Shared policy: https://github.com/seijikohara/renovate-config
  extends: ['github>seijikohara/renovate-config:default.json5'],
  packageRules: [
    {
      description: 'Group the Vue framework and state/router',
      groupName: 'vue',
      matchPackageNames: ['vue', 'vue-router', 'pinia', '@vueuse/*', '@vue/*', 'vue-tsc'],
    },
    {
      description: 'Group PrimeVue packages',
      groupName: 'primevue',
      matchPackageNames: ['primevue', '@primeuix/*', 'primeicons'],
    },
    {
      description: 'Group CodeMirror packages',
      groupName: 'codemirror',
      matchPackageNames: ['codemirror', '@codemirror/*'],
    },
    {
      // oxlint declares the oxlint-tsgolint version it needs as a peer dependency,
      // and oxlint-tsgolint moves to a new major with TypeScript. Keep majors in the
      // same PR so oxlint never lands without a matching oxlint-tsgolint.
      description: 'Group the oxc linting and formatting toolchain',
      groupName: 'linting and formatting',
      matchPackageNames: ['oxlint', 'oxfmt', 'oxlint-tsgolint'],
      separateMajorMinor: false,
    },
    {
      description: 'Group the test toolchain',
      groupName: 'testing',
      matchPackageNames: ['vitest', '@vitest/*'],
    },
    {
      description: 'Group Playwright packages',
      groupName: 'playwright',
      matchPackageNames: ['@playwright/*'],
    },
    {
      description: 'Group the build toolchain',
      groupName: 'build toolchain',
      matchPackageNames: ['vite', '@vitejs/*', 'sass', 'lefthook'],
    },
    {
      // TypeScript 7.0 ships no JS API, and vue-tsc and the Vue language tools still load the
      // TypeScript 6 API. Unblock when TypeScript 7.1 is stable and either vue-tsc supports it
      // (vuejs/language-tools#6170, content mapper) or golar 1.0 is released.
      description: 'Hold TypeScript on 6.x until vue-tsc supports TypeScript 7',
      matchPackageNames: ['typescript'],
      allowedVersions: '<7',
    },
    {
      description: 'Group TypeScript type definitions',
      groupName: 'type definitions',
      matchPackageNames: ['@types/*', '@tsconfig/*'],
    },
    {
      description: 'Group Vue plugins maintained alongside the app',
      groupName: 'vue plugins',
      matchPackageNames: ['json-tree-view-vue3', 'vue-codemirror6', 'vue-gtag'],
    },
    {
      description: 'Group formatters and parsers',
      groupName: 'formatters and parsers',
      matchPackageNames: [
        'marked',
        'dompurify',
        'sql-formatter',
        'xml-formatter',
        'yaml',
        'regexp-tree',
      ],
    },
    {
      description: 'Group HTTP and validation libraries',
      groupName: 'http and validation',
      matchPackageNames: ['axios', 'ajv', 'ajv-formats'],
    },
    {
      description: 'Group crypto and utility libraries',
      groupName: 'crypto and utilities',
      matchPackageNames: ['@noble/hashes', 'bcryptjs', 'dayjs', 'qrcode', 'ua-parser-js'],
    },
    {
      description: 'Keep ua-parser-js on the MIT-licensed 1.x line; 2.x is licensed AGPL-3.0-or-later',
      matchPackageNames: ['ua-parser-js'],
      allowedVersions: '<2',
    },
  ],
}
